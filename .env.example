APP_NAME="Wahla Cloth House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — all app data (users, orders, order_items, products, categories)
# is read/written through Laravel Eloquent to this connection.
# Use MySQL in production and for local dev if you want one shared DB.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wahla_cloth_house
DB_USERNAME=root
DB_PASSWORD=

# Laravel API reads/writes THIS database. phpMyAdmin must connect to the SAME MySQL instance
# (same host + port, or same socket). If you see users in Laravel but not in phpMyAdmin, you have
# two MySQL servers (e.g. MAMP on 8889 vs Homebrew on 3306). Match DB_PORT / DB_HOST / DB_SOCKET.
# Temporary check (with APP_DEBUG=true): GET http://127.0.0.1:8000/api/db-check

# After configuring .env (first time or new machine):
#   php artisan key:generate   # if APP_KEY is empty
#   php artisan migrate --seed # creates all tables + admin + demo user + categories + products

# Zero-setup alternative (no MySQL): comment the block above and use:
# DB_CONNECTION=sqlite
# (leave DB_* unset; Laravel uses database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
